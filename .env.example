# Copy this file to .env and fill in real values.

# Supabase Postgres via the connection pooler (IPv4-compatible — the direct
# db.[project-ref].supabase.co host is IPv6-only and often unreachable).
# Get these from Supabase: Connect -> ORM -> Prisma.
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Resend transactional email (https://resend.com) — free tier API key
RESEND_API_KEY=""
EMAIL_FROM="Chavous Transportation <onboarding@resend.dev>"
NOTIFY_EMAIL="dispatch@chavousllc.com"

# NextAuth — generate a secret with `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Encrypts SSN / bank account number on driver applications at rest —
# generate a key with `openssl rand -base64 32`
APPLICATION_ENCRYPTION_KEY=""

# Seed-time only: creates the first admin login when you run `npx prisma db seed`
ADMIN_EMAIL="safety@chavousllc.com"
ADMIN_PASSWORD="change-this-password"
